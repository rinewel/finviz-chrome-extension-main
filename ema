//@version=6

indicator('Y EMA Clouds', 'EMA_Y', overlay = true)

// ─────────────────────────────────────────────
// 常量
// ─────────────────────────────────────────────
GROUP_GLOBAL  = "General Settings"
GROUP_MTF     = "(MTF云图)"

// ─────────────────────────────────────────────
// 通用设置
// ─────────────────────────────────────────────
maTypeInput        = input.string(title = 'MA Type', defval = 'EMA', options = ['EMA', 'SMA'], display = display.none)
showMtfInput       = input.bool(true, "显示MTF云图", group = GROUP_GLOBAL, display = display.none)
showMtfLabelsInput = input.bool(true, "总开关 - 显示 MTF 标签", tooltip = "Overall ON/OFF gate for all 5 timeframe tags. A label only shows when this AND its own switch below are both ON.", group = GROUP_GLOBAL, display = display.none)

// ─────────────────────────────────────────────
// 当前周期 EMA 云
// ─────────────────────────────────────────────
cloud1FastLenInput = input.int(8,   title = 'Short EMA1 Length', minval = 1, display = display.none)
cloud1SlowLenInput = input.int(9,   title = 'Long EMA1 Length',  minval = 1, display = display.none)
cloud2FastLenInput = input.int(5,   title = 'Short EMA2 Length', minval = 1, display = display.none)
cloud2SlowLenInput = input.int(12,  title = 'Long EMA2 Length',  minval = 1, display = display.none)
cloud3FastLenInput = input.int(34,  title = 'Short EMA3 Length', minval = 1, display = display.none)
cloud3SlowLenInput = input.int(50,  title = 'Long EMA3 Length',  minval = 1, display = display.none)
cloud4FastLenInput = input.int(20,  title = 'Short EMA4 Length', minval = 1, display = display.none)
cloud4SlowLenInput = input.int(21,  title = 'Long EMA4 Length',  minval = 1, display = display.none)
cloud5FastLenInput = input.int(72,  title = 'Short EMA5 Length', minval = 1, display = display.none)
cloud5SlowLenInput = input.int(89,  title = 'Long EMA5 Length',  minval = 1, display = display.none)
cloud6FastLenInput = input.int(180, title = 'Short EMA6 Length', minval = 1, display = display.none)
cloud6SlowLenInput = input.int(200, title = 'Long EMA6 Length',  minval = 1, display = display.none)

srcInput = input.source(hl2, title = 'Source', display = display.none)

calcMa(length) =>
    switch maTypeInput
        'EMA' => ta.ema(srcInput, length)
        => ta.sma(srcInput, length)

cloud1Fast = calcMa(cloud1FastLenInput)
cloud1Slow = calcMa(cloud1SlowLenInput)
cloud2Fast = calcMa(cloud2FastLenInput)
cloud2Slow = calcMa(cloud2SlowLenInput)
cloud3Fast = calcMa(cloud3FastLenInput)
cloud3Slow = calcMa(cloud3SlowLenInput)
cloud4Fast = calcMa(cloud4FastLenInput)
cloud4Slow = calcMa(cloud4SlowLenInput)
cloud5Fast = calcMa(cloud5FastLenInput)
cloud5Slow = calcMa(cloud5SlowLenInput)
cloud6Fast = calcMa(cloud6FastLenInput)
cloud6Slow = calcMa(cloud6SlowLenInput)

showLineInput   = input(false, title = 'Display EMA Line', display = display.none)
showCloud1Input = input(true, title = 'Show EMA Cloud-1', display = display.none)
showCloud2Input = input(true, title = 'Show EMA Cloud-2', display = display.none)
showCloud3Input = input(true, title = 'Show EMA Cloud-3', display = display.none)
showCloud4Input = input(true, title = 'Show EMA Cloud-4', display = display.none)
showCloud5Input = input(true, title = 'Show EMA Cloud-5', display = display.none)
showCloud6Input = input(true, title = 'Show EMA Cloud-6', display = display.none)

cloudLeadInput = input.int(0, minval = 0, title = 'Leading Period For EMA Cloud', display = display.none)

cloud1Color = cloud1Fast >= cloud1Slow ? #036103 : #880e4f
cloud2Color = cloud2Fast >= cloud2Slow ? #4caf50 : #f44336
cloud3Color = cloud3Fast >= cloud3Slow ? #2196f3 : #ffb74d
cloud4Color = cloud4Fast >= cloud4Slow ? #550080 : #FF00FF
cloud5Color = cloud5Fast >= cloud5Slow ? #009688 : #f06292
cloud6Color = cloud6Fast >= cloud6Slow ? #05bed5 : #e65100

cloud1FastLineColor = cloud1Fast >= cloud1Fast[1] ? color.olive : color.maroon
cloud2FastLineColor = cloud2Fast >= cloud2Fast[1] ? color.olive : color.maroon
cloud3FastLineColor = cloud3Fast >= cloud3Fast[1] ? color.olive : color.maroon
cloud4FastLineColor = cloud4Fast >= cloud4Fast[1] ? color.olive : color.maroon
cloud5FastLineColor = cloud5Fast >= cloud5Fast[1] ? color.olive : color.maroon
cloud6FastLineColor = cloud6Fast >= cloud6Fast[1] ? color.olive : color.maroon

// editable=false により、Styleタブに個別の線色/太さ/線種ピッカーが表示されなくなる
cloud1FastPlot = plot(showCloud1Input ? cloud1Fast : na, color = showLineInput ? cloud1FastLineColor : na, linewidth = 1, offset = cloudLeadInput, title = 'Short Leading EMA1', editable = false, display = display.pane)
cloud2FastPlot = plot(showCloud2Input ? cloud2Fast : na, color = showLineInput ? cloud2FastLineColor : na, linewidth = 1, offset = cloudLeadInput, title = 'Short Leading EMA2', editable = false, display = display.pane)
cloud3FastPlot = plot(showCloud3Input ? cloud3Fast : na, color = showLineInput ? cloud3FastLineColor : na, linewidth = 1, offset = cloudLeadInput, title = 'Short Leading EMA3', editable = false, display = display.pane)
cloud4FastPlot = plot(showCloud4Input ? cloud4Fast : na, color = showLineInput ? cloud4FastLineColor : na, linewidth = 1, offset = cloudLeadInput, title = 'Short Leading EMA4', editable = false, display = display.pane)
cloud5FastPlot = plot(showCloud5Input ? cloud5Fast : na, color = showLineInput ? cloud5FastLineColor : na, linewidth = 1, offset = cloudLeadInput, title = 'Short Leading EMA5', editable = false, display = display.pane)
cloud6FastPlot = plot(showCloud6Input ? cloud6Fast : na, color = showLineInput ? cloud6FastLineColor : na, linewidth = 1, offset = cloudLeadInput, title = 'Short Leading EMA6', editable = false, display = display.pane)

cloud1SlowLineColor = cloud1Slow >= cloud1Slow[1] ? color.green : color.red
cloud2SlowLineColor = cloud2Slow >= cloud2Slow[1] ? color.green : color.red
cloud3SlowLineColor = cloud3Slow >= cloud3Slow[1] ? color.green : color.red
cloud4SlowLineColor = cloud4Slow >= cloud4Slow[1] ? color.green : color.red
cloud5SlowLineColor = cloud5Slow >= cloud5Slow[1] ? color.green : color.red
cloud6SlowLineColor = cloud6Slow >= cloud6Slow[1] ? color.green : color.red

cloud1SlowPlot = plot(showCloud1Input ? cloud1Slow : na, color = showLineInput ? cloud1SlowLineColor : na, linewidth = 3, offset = cloudLeadInput, title = 'Long Leading EMA1', editable = false, display = display.pane)
cloud2SlowPlot = plot(showCloud2Input ? cloud2Slow : na, color = showLineInput ? cloud2SlowLineColor : na, linewidth = 3, offset = cloudLeadInput, title = 'Long Leading EMA2', editable = false, display = display.pane)
cloud3SlowPlot = plot(showCloud3Input ? cloud3Slow : na, color = showLineInput ? cloud3SlowLineColor : na, linewidth = 3, offset = cloudLeadInput, title = 'Long Leading EMA3', editable = false, display = display.pane)
cloud4SlowPlot = plot(showCloud4Input ? cloud4Slow : na, color = showLineInput ? cloud4SlowLineColor : na, linewidth = 3, offset = cloudLeadInput, title = 'Long Leading EMA4', editable = false, display = display.pane)
cloud5SlowPlot = plot(showCloud5Input ? cloud5Slow : na, color = showLineInput ? cloud5SlowLineColor : na, linewidth = 3, offset = cloudLeadInput, title = 'Long Leading EMA5', editable = false, display = display.pane)
cloud6SlowPlot = plot(showCloud6Input ? cloud6Slow : na, color = showLineInput ? cloud6SlowLineColor : na, linewidth = 3, offset = cloudLeadInput, title = 'Long Leading EMA6', editable = false, display = display.pane)

fill(cloud1FastPlot, cloud1SlowPlot, color = color.new(cloud1Color, 45), title = 'MA Cloud1')
fill(cloud2FastPlot, cloud2SlowPlot, color = color.new(cloud2Color, 65), title = 'MA Cloud2')
fill(cloud3FastPlot, cloud3SlowPlot, color = color.new(cloud3Color, 70), title = 'MA Cloud3')
fill(cloud4FastPlot, cloud4SlowPlot, color = color.new(cloud4Color, 65), title = 'MA Cloud4')
fill(cloud5FastPlot, cloud5SlowPlot, color = color.new(cloud5Color, 65), title = 'MA Cloud5')
fill(cloud6FastPlot, cloud6SlowPlot, color = color.new(cloud6Color, 65), title = 'MA Cloud6')

// ─────────────────────────────────────────────
// VWAP
// ─────────────────────────────────────────────
anchorInput    = input.string(defval = 'Session', title = 'Anchor Period', options = ['Session', 'Week', 'Month', 'Year'], display = display.none)
vwapColorInput = input.color(color.new(#3A6CA8, 0), title = 'VWAP Color', group = 'Visual Settings', display = display.none)
vwapSrcInput   = input.source(hlc3, title = 'VWAP Source', tooltip = "标准 VWAP 使用 hlc3。改成 close 可恢复旧版数值。", group = 'Visual Settings', display = display.none)

// 使用内置 ta.vwap：timeframe.change 按交易所交易日/周/月/年切换，跨午夜开盘的品种也能正确处理
vwapAnchorTf = switch anchorInput
    'Session' => 'D'
    'Week'    => 'W'
    'Month'   => 'M'
    => '12M'

vwapValue = ta.vwap(vwapSrcInput, timeframe.change(vwapAnchorTf))
plot(vwapValue, title = 'VWAP', color = vwapColorInput, linewidth = 4, linestyle = plot.linestyle_dotted, editable = false, display = display.pane)

// ─────────────────────────────────────────────
// MTF 云图
// ─────────────────────────────────────────────
dayTfInput     = input.timeframe("1D", "Day MTF云图", group = GROUP_MTF, display = display.none)
dayLeadInput   = input.int(0, "Day Leading Period (MTF)", minval = 0, group = GROUP_MTF, display = display.none)
hourTfInput    = input.timeframe("60", "Hour MTF云图", group = GROUP_MTF, display = display.none)
hourLeadInput  = input.int(0, "Hour Leading Period (MTF)", minval = 0, group = GROUP_MTF, display = display.none)

dayCloud1OnInput  = input.bool(true, "Day MTF Cloud 1",  group = GROUP_MTF, inline = "m1",  display = display.none)
dayCloud2OnInput  = input.bool(true, "Day MTF Cloud 2",  group = GROUP_MTF, inline = "m2",  display = display.none)
dayCloud3OnInput  = input.bool(true, "Day MTF Cloud 3",  group = GROUP_MTF, inline = "m3",  display = display.none)
hourCloud4OnInput = input.bool(true, "Hour MTF Cloud 4", group = GROUP_MTF, inline = "m4",  display = display.none)
hourCloud5OnInput = input.bool(true, "Hour MTF Cloud 5", group = GROUP_MTF, inline = "m45", display = display.none)

// --- 标签开关 + 字体大小 + 颜色（同一行，子开关右边） ---
showLabel1Input  = input.bool(true, "Show Label - Cloud 1", group = GROUP_MTF, inline = "lbl1", display = display.none)
label1SizeInput  = input.string("huge", "", options = ["tiny", "small", "normal", "large", "huge"], group = GROUP_MTF, inline = "lbl1", display = display.none)
label1ColorInput = input.color(color.blue, "", group = GROUP_MTF, inline = "lbl1", display = display.none)

showLabel2Input  = input.bool(true, "Show Label - Cloud 2", group = GROUP_MTF, inline = "lbl2", display = display.none)
label2SizeInput  = input.string("huge", "", options = ["tiny", "small", "normal", "large", "huge"], group = GROUP_MTF, inline = "lbl2", display = display.none)
label2ColorInput = input.color(color.teal, "", group = GROUP_MTF, inline = "lbl2", display = display.none)

showLabel3Input  = input.bool(true, "Show Label - Cloud 3", group = GROUP_MTF, inline = "lbl3", display = display.none)
label3SizeInput  = input.string("huge", "", options = ["tiny", "small", "normal", "large", "huge"], group = GROUP_MTF, inline = "lbl3", display = display.none)
label3ColorInput = input.color(color.purple, "", group = GROUP_MTF, inline = "lbl3", display = display.none)

showLabel4Input  = input.bool(false, "Show Label - Cloud 4", group = GROUP_MTF, inline = "lbl4", display = display.none)
label4SizeInput  = input.string("huge", "", options = ["tiny", "small", "normal", "large", "huge"], group = GROUP_MTF, inline = "lbl4", display = display.none)
label4ColorInput = input.color(color.orange, "", group = GROUP_MTF, inline = "lbl4", display = display.none)

showLabel5Input  = input.bool(false, "Show Label - Cloud 5", group = GROUP_MTF, inline = "lbl5", display = display.none)
label5SizeInput  = input.string("huge", "", options = ["tiny", "small", "normal", "large", "huge"], group = GROUP_MTF, inline = "lbl5", display = display.none)
label5ColorInput = input.color(color.fuchsia, "", group = GROUP_MTF, inline = "lbl5", display = display.none)

labelOffsetInput = input.int(2, "MTF Label Offset (bars)", minval = 0, tooltip = "How many bars to the right of the last candle the label sits.", group = GROUP_MTF, display = display.none)

// 把字符串选项转换成 label.new 需要的 size.* 常量
toLabelSize(sizeStr) =>
    switch sizeStr
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.small

dayFast1Input  = input.int(8,  title = "Day EMA 1 Short Length Cloud",  minval = 1, display = display.none)
daySlow1Input  = input.int(9,  title = "Day EMA 1 Long Length Cloud",   minval = 1, display = display.none)
dayFast2Input  = input.int(20, title = "Day EMA 2 Short Length Cloud",  minval = 1, display = display.none)
daySlow2Input  = input.int(21, title = "Day EMA 2 Long Length Cloud",   minval = 1, display = display.none)
dayFast3Input  = input.int(50, title = "Day EMA 3 Short Length Cloud",  minval = 1, display = display.none)
daySlow3Input  = input.int(55, title = "Day EMA 3 Long Length Cloud",   minval = 1, display = display.none)
hourFast4Input = input.int(34, title = "Hour EMA 4 Short Length Cloud", minval = 1, display = display.none)
hourSlow4Input = input.int(50, title = "Hour EMA 4 Long Length Cloud",  minval = 1, display = display.none)
hourFast5Input = input.int(50, title = "Hour EMA 5 Short Length Cloud", minval = 1, display = display.none)
hourSlow5Input = input.int(55, title = "Hour EMA 5 Long Length Cloud",  minval = 1, display = display.none)

// 高周期均线：跟随 MA Type 设置（实时跟随当前未收盘的高周期K线）
[dayFast1, daySlow1, dayFast2, daySlow2, dayFast3, daySlow3] = request.security(syminfo.tickerid, dayTfInput,
     [calcMa(dayFast1Input), calcMa(daySlow1Input),
      calcMa(dayFast2Input), calcMa(daySlow2Input),
      calcMa(dayFast3Input), calcMa(daySlow3Input)])

[hourFast4, hourSlow4, hourFast5, hourSlow5] = request.security(syminfo.tickerid, hourTfInput,
     [calcMa(hourFast4Input), calcMa(hourSlow4Input),
      calcMa(hourFast5Input), calcMa(hourSlow5Input)])

// MTF 周期必须 ≥ 图表周期，否则取到的是低周期最后一根的值，没有意义
chartTfSeconds = timeframe.in_seconds()
dayCloudValid  = timeframe.in_seconds(dayTfInput)  >= chartTfSeconds
hourCloudValid = timeframe.in_seconds(hourTfInput) >= chartTfSeconds

showDayCloud1  = showMtfInput and dayCloud1OnInput  and dayCloudValid
showDayCloud2  = showMtfInput and dayCloud2OnInput  and dayCloudValid
showDayCloud3  = showMtfInput and dayCloud3OnInput  and dayCloudValid
showHourCloud4 = showMtfInput and hourCloud4OnInput and hourCloudValid
showHourCloud5 = showMtfInput and hourCloud5OnInput and hourCloudValid

dayCloud1Color  = color.new(color.blue, 85)
dayCloud2Color  = color.new(color.teal, 85)
dayCloud3Color  = color.new(color.purple, 85)
hourCloud4Color = color.new(color.orange, 85)
hourCloud5Color = color.new(color.fuchsia, 85)

// editable=false により、Styleタブに個別の線色/太さ/線種ピッカーが表示されなくなる
dayCloud1FastPlot  = plot(showDayCloud1 ? dayFast1 : na, color = color.blue, offset = dayLeadInput, linewidth = 2, title = "EMA 1 Short", editable = false, display = display.pane)
dayCloud1SlowPlot  = plot(showDayCloud1 ? daySlow1 : na, color = color.blue, offset = dayLeadInput, linewidth = 2, title = "EMA 1 Long",  editable = false, display = display.pane)

dayCloud2FastPlot  = plot(showDayCloud2 ? dayFast2 : na, color = color.teal, offset = dayLeadInput, linewidth = 2, title = "EMA 2 Short", editable = false, display = display.pane)
dayCloud2SlowPlot  = plot(showDayCloud2 ? daySlow2 : na, color = color.teal, offset = dayLeadInput, linewidth = 2, title = "EMA 2 Long",  editable = false, display = display.pane)

dayCloud3FastPlot  = plot(showDayCloud3 ? dayFast3 : na, color = color.purple, offset = dayLeadInput, linewidth = 2, title = "EMA 3 Short", editable = false, display = display.pane)
dayCloud3SlowPlot  = plot(showDayCloud3 ? daySlow3 : na, color = color.purple, offset = dayLeadInput, linewidth = 2, title = "EMA 3 Long",  editable = false, display = display.pane)

hourCloud4FastPlot = plot(showHourCloud4 ? hourFast4 : na, color = color.orange, offset = hourLeadInput, linewidth = 2, title = "EMA 4 Short", editable = false, display = display.pane)
hourCloud4SlowPlot = plot(showHourCloud4 ? hourSlow4 : na, color = color.orange, offset = hourLeadInput, linewidth = 2, title = "EMA 4 Long",  editable = false, display = display.pane)

hourCloud5FastPlot = plot(showHourCloud5 ? hourFast5 : na, color = color.fuchsia, offset = hourLeadInput, linewidth = 2, title = "EMA 5 Short", editable = false, display = display.pane)
hourCloud5SlowPlot = plot(showHourCloud5 ? hourSlow5 : na, color = color.fuchsia, offset = hourLeadInput, linewidth = 2, title = "EMA 5 Long",  editable = false, display = display.pane)

fill(dayCloud1FastPlot,  dayCloud1SlowPlot,  color = dayCloud1Color,  title = "EMA 1 Cloud")
fill(dayCloud2FastPlot,  dayCloud2SlowPlot,  color = dayCloud2Color,  title = "EMA 2 Cloud")
fill(dayCloud3FastPlot,  dayCloud3SlowPlot,  color = dayCloud3Color,  title = "EMA 3 Cloud")
fill(hourCloud4FastPlot, hourCloud4SlowPlot, color = hourCloud4Color, title = "EMA 4 Cloud")
fill(hourCloud5FastPlot, hourCloud5SlowPlot, color = hourCloud5Color, title = "EMA 5 Cloud")

// --- Timeframe badge to the right of each MTF cloud (e.g. "1D", "1H", "1M", "30S") ---
// 直接解析周期字符串，避免月线 (1M = 2628003 秒) 和秒级周期被误算成分钟
formatTimeframe(tf) =>
    tfStr    = tf == "" ? timeframe.period : tf
    unitChar = str.substring(tfStr, str.length(tfStr) - 1)
    string result = na
    if unitChar == "M" or unitChar == "W" or unitChar == "D" or unitChar == "S"
        multStr = str.substring(tfStr, 0, str.length(tfStr) - 1)
        result := (multStr == "" ? "1" : multStr) + unitChar
    else
        minutes = int(str.tonumber(tfStr))
        result := minutes % 60 == 0 ? str.tostring(int(minutes / 60)) + "H" : str.tostring(minutes) + "m"
    result

// 标签只在第一根K线创建一次，之后在最后一根K线上只更新位置/文字/样式
newMtfLabel() =>
    label.new(bar_index, na, "", style = label.style_label_left, color = color.new(color.black, 100))

var label dayLabel1  = newMtfLabel()
var label dayLabel2  = newMtfLabel()
var label dayLabel3  = newMtfLabel()
var label hourLabel4 = newMtfLabel()
var label hourLabel5 = newMtfLabel()

updateMtfLabel(lbl, isVisible, fastValue, slowValue, tf, fastLen, slowLen, txtColor, sizeStr) =>
    label.set_xy(lbl, bar_index + labelOffsetInput, isVisible ? (fastValue + slowValue) / 2 : na)
    label.set_text(lbl, isVisible ? formatTimeframe(tf) + " " + str.tostring(fastLen) + "-" + str.tostring(slowLen) : "")
    label.set_textcolor(lbl, txtColor)
    label.set_size(lbl, toLabelSize(sizeStr))

if barstate.islast
    updateMtfLabel(dayLabel1,  showMtfLabelsInput and showLabel1Input and showDayCloud1,  dayFast1,  daySlow1,  dayTfInput,  dayFast1Input,  daySlow1Input,  label1ColorInput, label1SizeInput)
    updateMtfLabel(dayLabel2,  showMtfLabelsInput and showLabel2Input and showDayCloud2,  dayFast2,  daySlow2,  dayTfInput,  dayFast2Input,  daySlow2Input,  label2ColorInput, label2SizeInput)
    updateMtfLabel(dayLabel3,  showMtfLabelsInput and showLabel3Input and showDayCloud3,  dayFast3,  daySlow3,  dayTfInput,  dayFast3Input,  daySlow3Input,  label3ColorInput, label3SizeInput)
    updateMtfLabel(hourLabel4, showMtfLabelsInput and showLabel4Input and showHourCloud4, hourFast4, hourSlow4, hourTfInput, hourFast4Input, hourSlow4Input, label4ColorInput, label4SizeInput)
    updateMtfLabel(hourLabel5, showMtfLabelsInput and showLabel5Input and showHourCloud5, hourFast5, hourSlow5, hourTfInput, hourFast5Input, hourSlow5Input, label5ColorInput, label5SizeInput)

// ─────────────────────────────────────────────
// 5-12 云翻转（移植自 Swing Dashboard，去掉警报，改为三角形）
// 直接使用 Cloud 2 的两条线判断，与云变色同步
// ─────────────────────────────────────────────
isFlipBull = cloud2Fast >= cloud2Slow
flipToBull = isFlipBull and not isFlipBull[1]
flipToBear = not isFlipBull and isFlipBull[1]

plotshape(flipToBull, title = "5-12 翻多", style = shape.triangleup,   location = location.belowbar, color = color.rgb(45, 96, 46), size = size.small, editable = false, display = display.pane)
plotshape(flipToBear, title = "5-12 翻空", style = shape.triangledown, location = location.abovebar, color = #880b0bf5,            size = size.small, editable = false, display = display.pane)

