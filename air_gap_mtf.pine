// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// 原始概念 © Mereep01（Air Gap MTF with alert settings + Table），此处用 Pine v6 重写

// 在当前图表上用水平线标出 4 个周期 × 4 条 EMA 的当前位置。
// 相邻 EMA 之间的空白区即 "air gap"：价格在其中阻力较小，空隙越大，潜在回报越高。

//@version=6
indicator("Air Gap MTF v6", "AirGap", overlay = true, max_lines_count = 100, max_labels_count = 100)

// ─────────────────────────────────────────────
// 常量 / 类型
// ─────────────────────────────────────────────
G_GEN   = "通用设置"
G_TF1   = "周期 1"
G_TF2   = "周期 2"
G_TF3   = "周期 3"
G_TF4   = "周期 4"
G_TABLE = "表格"
G_ALERT = "警报"

PRICE_ROW = "── 当前价格 ──"

type Level
    string name
    float  value
    color  col
    bool   isPrice

// ─────────────────────────────────────────────
// 通用设置
// ─────────────────────────────────────────────
srcInput         = input.source(hl2, "数据源", group = G_GEN)
showLinesInput   = input.bool(true, "水平线", group = G_GEN, inline = "sw")
showLabelsInput  = input.bool(true, "标签", group = G_GEN, inline = "sw")
showAxisInput    = input.bool(true, "价格轴标记", group = G_GEN, inline = "sw")
drawModeInput    = input.string("当日开盘起", "线条起点", options = ["当日开盘起", "最后K线左移", "贯穿整个图表"], group = G_GEN)
lineBackInput    = input.int(25, "左移K线数", minval = 0, tooltip = "仅在「最后K线左移」模式下生效", group = G_GEN)
lineWidthInput   = input.int(2, "线宽", minval = 1, maxval = 10, group = G_GEN, inline = "ls")
lineStyleInput   = input.string("实线", "", options = ["实线", "虚线", "点线"], group = G_GEN, inline = "ls")
labelOffsetInput = input.int(7, "标签右移K线数", minval = 0, group = G_GEN)
labelSizeInput   = input.string("normal", "标签字号", options = ["tiny", "small", "normal", "large", "huge"], group = G_GEN, inline = "lb")
labelTextInput   = input.color(color.black, "", group = G_GEN, inline = "lb")
labelPriceInput  = input.bool(true, "标签显示价格", group = G_GEN)

// ─────────────────────────────────────────────
// 周期设置：每个周期一行开关/周期/颜色，一行 4 个 EMA 长度（填 0 关闭该条）
// ─────────────────────────────────────────────
LEN_TIP = "填 0 可关闭该条 EMA"

tf1On  = input.bool(true, "", group = G_TF1, inline = "a")
tf1    = input.timeframe("30", "周期", group = G_TF1, inline = "a")
tf1Col = input.color(#ff5252, "", group = G_TF1, inline = "a")
tf1L1  = input.int(5,  "EMA", minval = 0, group = G_TF1, inline = "b")
tf1L2  = input.int(12, "",    minval = 0, group = G_TF1, inline = "b")
tf1L3  = input.int(34, "",    minval = 0, group = G_TF1, inline = "b")
tf1L4  = input.int(50, "",    minval = 0, group = G_TF1, inline = "b", tooltip = LEN_TIP)

tf2On  = input.bool(true, "", group = G_TF2, inline = "a")
tf2    = input.timeframe("60", "周期", group = G_TF2, inline = "a")
tf2Col = input.color(#00e676, "", group = G_TF2, inline = "a")
tf2L1  = input.int(5,  "EMA", minval = 0, group = G_TF2, inline = "b")
tf2L2  = input.int(12, "",    minval = 0, group = G_TF2, inline = "b")
tf2L3  = input.int(34, "",    minval = 0, group = G_TF2, inline = "b")
tf2L4  = input.int(50, "",    minval = 0, group = G_TF2, inline = "b", tooltip = LEN_TIP)

tf3On  = input.bool(true, "", group = G_TF3, inline = "a")
tf3    = input.timeframe("240", "周期", group = G_TF3, inline = "a")
tf3Col = input.color(#ffeb3b, "", group = G_TF3, inline = "a")
tf3L1  = input.int(5,  "EMA", minval = 0, group = G_TF3, inline = "b")
tf3L2  = input.int(12, "",    minval = 0, group = G_TF3, inline = "b")
tf3L3  = input.int(34, "",    minval = 0, group = G_TF3, inline = "b")
tf3L4  = input.int(50, "",    minval = 0, group = G_TF3, inline = "b", tooltip = LEN_TIP)

tf4On  = input.bool(true, "", group = G_TF4, inline = "a")
tf4    = input.timeframe("1D", "周期", group = G_TF4, inline = "a")
tf4Col = input.color(#00e5ff, "", group = G_TF4, inline = "a")
tf4L1  = input.int(5,  "EMA", minval = 0, group = G_TF4, inline = "b")
tf4L2  = input.int(12, "",    minval = 0, group = G_TF4, inline = "b")
tf4L3  = input.int(34, "",    minval = 0, group = G_TF4, inline = "b")
tf4L4  = input.int(50, "",    minval = 0, group = G_TF4, inline = "b", tooltip = LEN_TIP)

// ─────────────────────────────────────────────
// 表格设置
// ─────────────────────────────────────────────
showTableInput   = input.bool(true, "显示表格", group = G_TABLE)
tablePosInput    = input.string(position.top_right, "位置", options = [position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_center, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right], group = G_TABLE)
tableLayoutInput = input.string("排序", "布局", options = ["排序", "标准"], tooltip = "排序：按价格从高到低排列并插入当前价格行，显示相邻空隙。标准：按周期顺序排列。", group = G_TABLE)
tableSizeInput   = input.string("normal", "字号", options = ["tiny", "small", "normal", "large", "huge"], group = G_TABLE)
rowBgModeInput   = input.string("线条颜色", "行背景", options = ["线条颜色", "相对价格"], group = G_TABLE)
aboveColInput    = input.color(color.new(#00ff08, 0), "EMA 在价格上方", group = G_TABLE, inline = "ab")
belowColInput    = input.color(color.new(#ff0000, 0), "下方", group = G_TABLE, inline = "ab")
rowTextInput     = input.color(color.black, "行文字", group = G_TABLE, inline = "rt")
posDiffInput     = input.color(color.new(color.green, 10), "正差值", group = G_TABLE, inline = "rt")
negDiffInput     = input.color(color.new(color.red, 10), "负差值", group = G_TABLE, inline = "rt")
headerBgInput    = input.color(color.gray, "表头背景", group = G_TABLE, inline = "hd")
headerTextInput  = input.color(color.white, "文字", group = G_TABLE, inline = "hd")
priceBgInput     = input.color(color.new(color.gray, 80), "价格行背景", group = G_TABLE, inline = "pr")
priceTextInput   = input.color(color.white, "文字", group = G_TABLE, inline = "pr")
atrTfInput       = input.timeframe("1D", "空隙单位 ATR 周期", group = G_TABLE, inline = "atr")
atrLenInput      = input.int(14, "长度", minval = 1, group = G_TABLE, inline = "atr")

// ─────────────────────────────────────────────
// 警报设置
// ─────────────────────────────────────────────
alertOnInput    = input.bool(true, "启用 alert() 穿越提醒", tooltip = "创建警报时选择「任何 alert() 函数调用」，消息里会写明穿越了哪条 EMA。", group = G_ALERT)
alertCloseInput = input.bool(true, "仅在K线收盘时确认", group = G_ALERT)

// ─────────────────────────────────────────────
// 工具函数
// ─────────────────────────────────────────────
toSize(string s) =>
    switch s
        "tiny"  => size.tiny
        "small" => size.small
        "large" => size.large
        "huge"  => size.huge
        => size.normal

// "30" → "30m"，"240" → "4H"，"1D" → "1D"
formatTf(string tf) =>
    string t    = tf == "" ? timeframe.period : tf
    string unit = str.substring(t, str.length(t) - 1)
    string result = ""
    if unit == "M" or unit == "W" or unit == "D" or unit == "S"
        string mult = str.substring(t, 0, str.length(t) - 1)
        result := (mult == "" ? "1" : mult) + unit
    else
        int minutes = int(str.tonumber(t))
        result := minutes % 60 == 0 ? str.tostring(int(minutes / 60)) + "H" : str.tostring(minutes) + "m"
    result

emaName(int len, string tf) =>
    str.tostring(len) + " EMA " + formatTf(tf)

// 一次请求取回一个周期的 4 条 EMA（长度为 0 时用 1 占位，之后被开关屏蔽）
emaSet(int l1, int l2, int l3, int l4) =>
    [ta.ema(srcInput, math.max(l1, 1)), ta.ema(srcInput, math.max(l2, 1)), ta.ema(srcInput, math.max(l3, 1)), ta.ema(srcInput, math.max(l4, 1))]

// 高周期必须 ≥ 图表周期，否则取到的是低周期最后一根的值，没有意义
chartSec = timeframe.in_seconds()
tfOk(bool on, string tf) =>
    on and timeframe.in_seconds(tf) >= chartSec

fmtGap(float gap, float atr) =>
    str.tostring(gap, format.mintick) + (na(atr) or atr == 0 ? "" : "  " + str.tostring(gap / atr, "0.0") + "×")

// ─────────────────────────────────────────────
// 计算：4 次 request.security 取回 16 条 EMA
// ─────────────────────────────────────────────
[e11, e12, e13, e14] = request.security(syminfo.tickerid, tf1, emaSet(tf1L1, tf1L2, tf1L3, tf1L4))
[e21, e22, e23, e24] = request.security(syminfo.tickerid, tf2, emaSet(tf2L1, tf2L2, tf2L3, tf2L4))
[e31, e32, e33, e34] = request.security(syminfo.tickerid, tf3, emaSet(tf3L1, tf3L2, tf3L3, tf3L4))
[e41, e42, e43, e44] = request.security(syminfo.tickerid, tf4, emaSet(tf4L1, tf4L2, tf4L3, tf4L4))
atrVal = request.security(syminfo.tickerid, atrTfInput, ta.atr(atrLenInput))

ok1 = tfOk(tf1On, tf1)
ok2 = tfOk(tf2On, tf2)
ok3 = tfOk(tf3On, tf3)
ok4 = tfOk(tf4On, tf4)

// 只随输入变化的元数据，第一根K线建一次
var array<string> names = array.from(
     emaName(tf1L1, tf1), emaName(tf1L2, tf1), emaName(tf1L3, tf1), emaName(tf1L4, tf1),
     emaName(tf2L1, tf2), emaName(tf2L2, tf2), emaName(tf2L3, tf2), emaName(tf2L4, tf2),
     emaName(tf3L1, tf3), emaName(tf3L2, tf3), emaName(tf3L3, tf3), emaName(tf3L4, tf3),
     emaName(tf4L1, tf4), emaName(tf4L2, tf4), emaName(tf4L3, tf4), emaName(tf4L4, tf4))
var array<color> cols = array.from(
     tf1Col, tf1Col, tf1Col, tf1Col, tf2Col, tf2Col, tf2Col, tf2Col,
     tf3Col, tf3Col, tf3Col, tf3Col, tf4Col, tf4Col, tf4Col, tf4Col)
var array<bool> ons = array.from(
     ok1 and tf1L1 > 0, ok1 and tf1L2 > 0, ok1 and tf1L3 > 0, ok1 and tf1L4 > 0,
     ok2 and tf2L1 > 0, ok2 and tf2L2 > 0, ok2 and tf2L3 > 0, ok2 and tf2L4 > 0,
     ok3 and tf3L1 > 0, ok3 and tf3L2 > 0, ok3 and tf3L3 > 0, ok3 and tf3L4 > 0,
     ok4 and tf4L1 > 0, ok4 and tf4L2 > 0, ok4 and tf4L3 > 0, ok4 and tf4L4 > 0)

vals = array.from(e11, e12, e13, e14, e21, e22, e23, e24, e31, e32, e33, e34, e41, e42, e43, e44)

// ─────────────────────────────────────────────
// 穿越检测（上一根K线的 EMA 值存在 prevVals 里）
// ─────────────────────────────────────────────
var array<float> prevVals = array.new<float>()

bool   anyCross = false
string crossMsg = ""
if prevVals.size() == 16
    for i = 0 to 15
        float v = vals.get(i)
        float p = prevVals.get(i)
        if ons.get(i) and not na(v) and not na(p) and not na(close[1])
            bool up = close > v and close[1] <= p
            bool dn = close < v and close[1] >= p
            if up or dn
                anyCross := true
                crossMsg += "\n" + names.get(i) + (up ? " 上穿 " : " 下穿 ") + str.tostring(v, format.mintick)
prevVals := vals

if alertOnInput and anyCross
    alert(syminfo.ticker + " 价格穿越多周期 EMA:" + crossMsg, alertCloseInput ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
alertcondition(anyCross, "任一 EMA 穿越", "{{ticker}} 价格穿越了一条多周期 EMA")

// ─────────────────────────────────────────────
// 水平线 + 标签：只在最后一根K线上重建
// ─────────────────────────────────────────────
var int dayStartBar = na
if session.isfirstbar
    dayStartBar := bar_index

lineStyle = switch lineStyleInput
    "虚线" => line.style_dashed
    "点线" => line.style_dotted
    => line.style_solid

var array<line>  lines  = array.new<line>()
var array<label> labels = array.new<label>()

if barstate.islast
    for ln in lines
        line.delete(ln)
    for lb in labels
        label.delete(lb)
    lines.clear()
    labels.clear()

    int x1 = switch drawModeInput
        "最后K线左移"   => bar_index - lineBackInput
        "贯穿整个图表" => bar_index - 1
        => nz(dayStartBar, bar_index)
    int x2  = bar_index + labelOffsetInput
    ext     = drawModeInput == "贯穿整个图表" ? extend.both : extend.right

    for i = 0 to 15
        float v = vals.get(i)
        if ons.get(i) and not na(v)
            color c = cols.get(i)
            if showLinesInput
                lines.push(line.new(x1, v, x2, v, color = c, width = lineWidthInput, style = lineStyle, extend = ext))
            if showLabelsInput
                string txt = labelPriceInput ? names.get(i) + "  " + str.tostring(v, format.mintick) : names.get(i)
                labels.push(label.new(x2, v, txt, color = c, textcolor = labelTextInput, style = label.style_label_left, size = toSize(labelSizeInput)))

// ─────────────────────────────────────────────
// 价格轴标记（plot 只能写在全局作用域）
// ─────────────────────────────────────────────
plot(showAxisInput and ons.get(0)  ? e11 : na, "TF1 EMA1", tf1Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(1)  ? e12 : na, "TF1 EMA2", tf1Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(2)  ? e13 : na, "TF1 EMA3", tf1Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(3)  ? e14 : na, "TF1 EMA4", tf1Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(4)  ? e21 : na, "TF2 EMA1", tf2Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(5)  ? e22 : na, "TF2 EMA2", tf2Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(6)  ? e23 : na, "TF2 EMA3", tf2Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(7)  ? e24 : na, "TF2 EMA4", tf2Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(8)  ? e31 : na, "TF3 EMA1", tf3Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(9)  ? e32 : na, "TF3 EMA2", tf3Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(10) ? e33 : na, "TF3 EMA3", tf3Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(11) ? e34 : na, "TF3 EMA4", tf3Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(12) ? e41 : na, "TF4 EMA1", tf4Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(13) ? e42 : na, "TF4 EMA2", tf4Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(14) ? e43 : na, "TF4 EMA3", tf4Col, display = display.price_scale, editable = false)
plot(showAxisInput and ons.get(15) ? e44 : na, "TF4 EMA4", tf4Col, display = display.price_scale, editable = false)

// ─────────────────────────────────────────────
// 表格：均线 | 价格 | 差值 | 差值% | 空隙（与下一行的距离，附 ATR 倍数）
// 底部汇总：最近阻力 / 最近支撑 / 上下空间比
// ─────────────────────────────────────────────
var table tbl = table.new(tablePosInput, 5, 22, border_width = 1)

cell(int c, int r, string txt, color bg, color fg, string halign) =>
    table.cell(tbl, c, r, txt, bgcolor = bg, text_color = fg, text_halign = halign, text_size = toSize(tableSizeInput))

if barstate.islast and showTableInput
    table.clear(tbl, 0, 0, 4, 21)
    bool ordered = tableLayoutInput == "排序"

    array<Level> levels = array.new<Level>()
    for i = 0 to 15
        float v = vals.get(i)
        if ons.get(i) and not na(v)
            levels.push(Level.new(names.get(i), v, cols.get(i), false))
    if ordered
        levels.push(Level.new(PRICE_ROW, close, priceBgInput, true))

    array<float> vs = array.new<float>()
    for lv in levels
        vs.push(lv.value)
    array<int> idx = vs.sort_indices(order.descending)

    cell(0, 0, "均线",   headerBgInput, headerTextInput, text.align_center)
    cell(1, 0, "价格",   headerBgInput, headerTextInput, text.align_center)
    cell(2, 0, "差值",   headerBgInput, headerTextInput, text.align_center)
    cell(3, 0, "差值%",  headerBgInput, headerTextInput, text.align_center)
    cell(4, 0, ordered ? "空隙 (ATR倍)" : "", headerBgInput, headerTextInput, text.align_center)

    int n = levels.size()
    int r = 1
    if n > 0
        for i = 0 to n - 1
            Level lv = levels.get(ordered ? idx.get(i) : i)
            float diff = lv.value - close
            color bg = lv.isPrice ? priceBgInput : rowBgModeInput == "相对价格" ? (lv.value >= close ? aboveColInput : belowColInput) : lv.col
            color fg = lv.isPrice ? priceTextInput : rowTextInput
            color dc = diff >= 0 ? posDiffInput : negDiffInput

            cell(0, r, lv.name, bg, fg, text.align_left)
            cell(1, r, str.tostring(lv.value, format.mintick), bg, fg, text.align_right)
            cell(2, r, lv.isPrice ? "—" : str.tostring(diff, format.mintick), bg, lv.isPrice ? fg : dc, text.align_right)
            cell(3, r, lv.isPrice ? "—" : str.tostring(diff / close * 100, "0.00") + "%", bg, lv.isPrice ? fg : dc, text.align_right)
            if ordered and i < n - 1
                Level nx = levels.get(idx.get(i + 1))
                cell(4, r, fmtGap(lv.value - nx.value, atrVal), bg, fg, text.align_right)
            else
                cell(4, r, "", bg, fg, text.align_right)
            r += 1

    // 当前价格上下最近的 EMA = 这笔交易的 air gap
    float upLvl = na
    float dnLvl = na
    for lv in levels
        if not lv.isPrice
            if lv.value > close and (na(upLvl) or lv.value < upLvl)
                upLvl := lv.value
            if lv.value < close and (na(dnLvl) or lv.value > dnLvl)
                dnLvl := lv.value

    float upGap = upLvl - close
    float dnGap = close - dnLvl

    cell(0, r, "↑ 最近阻力", headerBgInput, headerTextInput, text.align_left)
    cell(1, r, na(upLvl) ? "无" : str.tostring(upLvl, format.mintick), headerBgInput, headerTextInput, text.align_right)
    cell(2, r, na(upLvl) ? "—" : str.tostring(upGap, format.mintick), headerBgInput, posDiffInput, text.align_right)
    cell(3, r, na(upLvl) ? "—" : str.tostring(upGap / close * 100, "0.00") + "%", headerBgInput, posDiffInput, text.align_right)
    cell(4, r, na(upLvl) ? "—" : fmtGap(upGap, atrVal), headerBgInput, headerTextInput, text.align_right)
    r += 1

    cell(0, r, "↓ 最近支撑", headerBgInput, headerTextInput, text.align_left)
    cell(1, r, na(dnLvl) ? "无" : str.tostring(dnLvl, format.mintick), headerBgInput, headerTextInput, text.align_right)
    cell(2, r, na(dnLvl) ? "—" : str.tostring(-dnGap, format.mintick), headerBgInput, negDiffInput, text.align_right)
    cell(3, r, na(dnLvl) ? "—" : str.tostring(-dnGap / close * 100, "0.00") + "%", headerBgInput, negDiffInput, text.align_right)
    cell(4, r, na(dnLvl) ? "—" : fmtGap(dnGap, atrVal), headerBgInput, headerTextInput, text.align_right)
    r += 1

    string ratioTxt = na(upLvl) or na(dnLvl) or dnGap == 0 ? "—" : str.tostring(upGap / dnGap, "0.00")
    cell(0, r, "上/下空间比", headerBgInput, headerTextInput, text.align_left)
    cell(1, r, ratioTxt, headerBgInput, headerTextInput, text.align_right)
    cell(2, r, "", headerBgInput, headerTextInput, text.align_right)
    cell(3, r, "", headerBgInput, headerTextInput, text.align_right)
    cell(4, r, "", headerBgInput, headerTextInput, text.align_right)
